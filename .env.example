# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase
# (Project Settings > API en el panel de Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://TUPROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para scripts de servidor/admin (nunca exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_PROJECT_ID=tuproyecto

# Dirección pública de la web, sin barra final. La usa el correo de "olvidé mi
# contraseña" para el enlace de entrada. Si no se define, usa la dirección desde
# la que se pidió el correo, así que es opcional pero recomendable en producción.
NEXT_PUBLIC_SITE_URL=https://fantasy.beraunberaxake.com

# Correo de recuperación de cuenta (Resend). Ver lib/emailRecuperacion.ts
RESEND_API_KEY=tu-clave-de-resend
EMAIL_FROM="Fantasy Beraun Bera <no-reply@tudominio.com>"
