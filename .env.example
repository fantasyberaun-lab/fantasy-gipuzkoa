# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase
# (Project Settings > API en el panel de Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://TUPROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para scripts de servidor/admin (nunca exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_PROJECT_ID=tuproyecto
